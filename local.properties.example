# Android SDK Directory
sdk.dir=/path/to/android/sdk

# Release Signing Configuration
release.storeFile=release.keystore
release.storePassword=YOUR_KEYSTORE_PASSWORD
release.keyAlias=tefillin
release.keyPassword=YOUR_KEY_PASSWORD

# Optional: Anonymous Bug Reporting Webhook (Discord / Telegram / Generic HTTP POST)
# Leave blank to fallback to the native Android system share sheet.
tefillin.bug_report_webhook_url=

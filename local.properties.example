# Android SDK Directory
sdk.dir=/path/to/android/sdk

# Release Signing Configuration
release.storeFile=release.keystore
release.storePassword=YOUR_KEYSTORE_PASSWORD
release.keyAlias=tefillin
release.keyPassword=YOUR_KEY_PASSWORD

# Anonymous Bug Reporting Webhook (Discord / Telegram / Generic HTTP POST)
# Configured by default to the Discord webhook endpoint.
tefillin.bug_report_webhook_url=https://discord.com/api/webhooks/...

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_card"
    android:padding="20dp"
    android:layout_margin="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bug_modal_title"
            android:textColor="@color/accent_gold"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bug_intro"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:background="#222"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bug_notes_label"
            android:textColor="@color/text_main"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="2"
            android:maxLines="4"
            android:gravity="top|start"
            android:hint="@string/bug_notes_hint"
            android:textColorHint="@color/text_subtle"
            android:textColor="@color/text_main"
            android:background="@drawable/bg_button_rounded"
            android:padding="10dp"
            android:textSize="13sp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnShare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/capture_and_share"
            android:backgroundTint="@color/accent_gold"
            android:textColor="@color/bg_primary"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnCopyLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/copy_logs"
            android:backgroundTint="#334155"
            android:textColor="@color/text_main"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnCloseBug"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/close"
            android:backgroundTint="@android:color/transparent"
            android:textColor="@color/text_muted" />

    </LinearLayout>
</ScrollView>

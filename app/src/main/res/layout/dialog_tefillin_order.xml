<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title -->
        <TextView
            android:id="@+id/tvOrderTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tefillin_order_title"
            android:textColor="@color/accent_gold"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Nusach Selector Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tefillin_order_nusach_label"
            android:textColor="@color/text_main"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Nusach Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNusachAshkenaz"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="4dp"
                android:text="@string/nusach_ashkenaz"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:cornerRadius="8dp"
                android:layout_marginEnd="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNusachSefard"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="4dp"
                android:text="@string/nusach_sefard"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:cornerRadius="8dp"
                android:layout_marginEnd="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNusachEdotMizrach"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="4dp"
                android:text="@string/nusach_edot_hamizrach"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/card_border"
            android:layout_marginBottom="16dp" />

        <!-- Step 1: Shel Yad -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_button_rounded"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/step1_yad_title"
                android:textColor="@color/accent_cyan"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/step1_yad_desc"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="8dp" />

            <!-- Blessing Box Shel Yad -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1B2234"
                android:text="@string/blessing_shel_yad"
                android:textColor="@color/accent_gold"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="12dp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/step1_yad_action"
                android:textColor="@color/text_main"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <!-- Step 2: Shel Rosh -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_button_rounded"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/step2_rosh_title"
                android:textColor="@color/accent_cyan"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/step2_rosh_desc"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="8dp" />

            <!-- Dynamic Blessing Container according to Nusach -->
            <LinearLayout
                android:id="@+id/containerRoshBlessing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRoshBlessingLead"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/step2_rosh_ashkenaz_blessing_title"
                    android:textColor="@color/text_main"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <!-- Blessing Box Shel Rosh -->
                <TextView
                    android:id="@+id/tvBlessingShelRosh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#1B2234"
                    android:text="@string/blessing_shel_rosh"
                    android:textColor="@color/accent_gold"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:padding="12dp"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvRoshAfterLead"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/step2_rosh_after_tightening"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp" />

                <!-- Baruch Shem Box -->
                <TextView
                    android:id="@+id/tvBlessingBaruchShem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#1B2234"
                    android:text="@string/blessing_baruch_shem"
                    android:textColor="@color/accent_gold"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:padding="10dp"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginBottom="8dp" />

                <!-- Halachic Note for Sefard / Edot HaMizrach -->
                <TextView
                    android:id="@+id/tvRoshInterruptedRule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/step2_rosh_sefard_interrupted"
                    android:textColor="@color/text_subtle"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Step 3: Finger Coils & Betrothal Verses -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_button_rounded"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/step3_hand_title"
                android:textColor="@color/accent_cyan"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/step3_hand_desc"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1B2234"
                android:text="@string/verses_erusin"
                android:textColor="@color/accent_gold"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="12dp"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <!-- Step 4: Parashot (Collapsible / Expandable) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_button_rounded"
            android:padding="14dp"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:id="@+id/layoutParashotToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tvParashotHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/step4_parashot_title"
                    android:textColor="@color/accent_cyan"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvParashotToggleHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/parashot_toggle_expand"
                    android:textColor="@color/accent_gold"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Collapsible Portions Container (Hidden by default, tap to expand) -->
            <LinearLayout
                android:id="@+id/layoutParashotContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="10dp">

                <!-- Parashah 1: Kadesh Li -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/parashat_kadesh_title"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvParashatKadesh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/parashat_kadesh"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginBottom="12dp" />

                <!-- Parashah 2: Vehaya Ki Yeviacha -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/parashat_vehaya_title"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvParashatVehaya"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/parashat_vehaya"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginBottom="12dp" />

                <!-- Parashah 3: Shema Yisrael -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/parashat_shema_title"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvParashatShema"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/parashat_shema"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginBottom="12dp" />

                <!-- Parashah 4: Vehaya Im Shamoa -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/parashat_vehaya_im_shamoa_title"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvParashatVehayaImShamoa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/parashat_vehaya_im_shamoa"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Close Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseOrder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/close"
            app:backgroundTint="@color/accent_gold"
            android:textColor="@color/bg_primary"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textAllCaps="false"
            app:cornerRadius="10dp" />

    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvModalTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bug_modal_title"
            android:textColor="@color/accent_gold"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bug_intro"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvPreviewLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bug_preview_label"
            android:textColor="@color/text_main"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:background="#151C2C"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bug_notes_label"
            android:textColor="@color/text_main"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="2"
            android:maxLines="3"
            android:gravity="top|start"
            android:hint="@string/bug_notes_hint"
            android:textColorHint="@color/text_subtle"
            android:textColor="@color/text_main"
            android:background="@drawable/bg_button_rounded"
            android:padding="10dp"
            android:textSize="13sp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/capture_and_share"
            app:backgroundTint="@color/accent_gold"
            android:textColor="@color/bg_primary"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textAllCaps="false"
            app:cornerRadius="10dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopyLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/copy_logs"
            app:backgroundTint="#334155"
            android:textColor="@color/text_main"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textAllCaps="false"
            app:cornerRadius="10dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseBug"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="@string/close"
            style="@style/Widget.Material3.Button.TextButton"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>
